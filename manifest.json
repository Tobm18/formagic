{
  "manifest_version": 3,
  "name": "Formagic",
  "version": "1.3.0",
  "description": "Remplissez n’importe quel PDF comme par magie : champs détectés automatiquement, signature, annotations. Gratuit et 100 % local.",
  "homepage_url": "https://github.com/Tobm18/formagic",
  "minimum_chrome_version": "120",
  "permissions": [
    "declarativeNetRequest",
    "webNavigation",
    "webRequest",
    "storage",
    "contextMenus"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Formagic",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["viewer.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
